# dev.env.example — copy to dev.env and run ./scripts/gen-secrets.sh to fill secrets.
# LOCAL DEV ONLY. Never in the deploy bundle.
NAVIDROME_USER=admin
NAVIDROME_PASS=dev-navidrome-pass-change-me
ZAYFETCH_TOKEN=dev-token-change-me
# Optional (free): Last.fm key for correction + radio tiers. Empty = skip.
LASTFM_API_KEY=

# YouTube Music connection: connect in the app (Settings → YouTube Music).
# Stored automatically under ./dev-zayfetch/cookies/youtube.txt; the
# variable below only overrides that path for custom layouts.
# YTDLP_COOKIES_FILE=/data/cookies/youtube.txt

# Managed browser session: the Chromium container owns the Google sign-in
# and zayfetch exports live cookies over CDP. Set BROWSER_CDP_URL empty to
# disable and use the stored cookies.txt only.
BROWSER_DATA_DIR=./browser/data
BROWSER_PORT=6080
# Over Tailscale, serve the loopback noVNC port and point the link there:
#   tailscale serve --bg --https=8446 http://127.0.0.1:6080
PUBLIC_REMOTE_BROWSER_URL=
# Google API OAuth (optional; API-only — downloads still need the session).
# Create an OAuth client of type "TVs and Limited Input devices":
# https://console.cloud.google.com/apis/credentials
YTM_OAUTH_CLIENT_ID=
YTM_OAUTH_CLIENT_SECRET=

# Automated re-login (optional): when Google ends the browser session,
# zayfetch signs itself back in with this Google account. TOTP secret is the
# authenticator setup code (base32), which lets 2FA challenges complete on
# their own. Leave EMAIL/PASSWORD empty to keep manual sign-in in noVNC.
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
GOOGLE_TOTP_SECRET=
# Minutes between automatic sign-in attempts (5 or more enforced).
YOUTUBE_RELOGIN_MIN_MINUTES=60

# Dev talks to the dev override on loopback (§4.3). NOT the compose-network names.
NAVIDROME_URL=http://127.0.0.1:4533
ZAYFETCH_URL=http://127.0.0.1:8081

MUSIC_DIR=./dev-music
NAVIDROME_DATA_DIR=./dev-navidrome
ZAYFETCH_DATA_DIR=./dev-zayfetch
APP_PORT=3847
