# ZayMusic production env — FAKE VALUES ONLY. Safe to commit.
# On the host, generate a real one with ./gen-secrets.sh (mode 600). NEVER commit a real .env.

# --- secrets ---
NAVIDROME_USER=admin
NAVIDROME_PASS=change-me-navidrome-pass
ZAYFETCH_TOKEN=change-me-zayfetch-token
# Optional (free): Last.fm key enables spelling correction, crowd-similar
# radio tier, and artist top-track fallback. Empty = those tiers skip.
LASTFM_API_KEY=

# --- YouTube Music (required for downloads) ---
# Connect your account in the app: Settings → YouTube Music. Sign in once in
# the app's managed browser — the session is kept alive for you. A pasted
# cookies.txt stays available under "Advanced — manual cookies".
# The file is stored at ./zayfetch/data/cookies/youtube.txt automatically.
# YTDLP_COOKIES_FILE only overrides that path for custom layouts:
# YTDLP_COOKIES_FILE=/data/cookies/youtube.txt

# --- managed browser session (the app's own Chromium) ---
# browser/data/ holds the live Google session — treat it as a credential store.
BROWSER_DATA_DIR=./browser/data
BROWSER_PORT=6080
# Set empty to disable browser mode and use only a pasted cookies.txt:
# BROWSER_CDP_URL=
# Where "Open remote browser" points. noVNC is loopback-only, so over
# Tailscale serve it and set this (replace <host> with this machine's name):
#   tailscale serve --bg --https=8446 http://127.0.0.1:6080
#   PUBLIC_REMOTE_BROWSER_URL=https://<host>.tailfc5dc.ts.net:8446/vnc.html
PUBLIC_REMOTE_BROWSER_URL=

# --- Google API OAuth (optional; API-only — downloads still need the session) ---
# OAuth client type must be "TVs and Limited Input devices" and the YouTube
# Data API must be enabled on the project. The consent screen must be
# Published, or in Testing with your Google account added as a test user.
YTM_OAUTH_CLIENT_ID=
YTM_OAUTH_CLIENT_SECRET=

# --- automated re-login (optional) ---
# When Google ends the browser session, the keeper signs itself back in with
# this account (password, and a TOTP code when the secret is set). Secrets
# are written to the real .env by gen-secrets.sh — fill these on the host.
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
GOOGLE_TOTP_SECRET=
YOUTUBE_RELOGIN_MIN_MINUTES=60

# --- paths (relative to ~/services/zaymusic/ on the host) ---
MUSIC_DIR=./music
NAVIDROME_DATA_DIR=./navidrome
ZAYFETCH_DATA_DIR=./zayfetch/data

# --- the ONE published host port. Loopback only. ---
# Avoid: 8080 (Vaultwarden), 8384, 22000, 51515, 8888, 3001
APP_PORT=3847
